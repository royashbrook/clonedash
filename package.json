{
  "name": "clonedash",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "preview": "node scripts/serve.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "node scripts/build.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:release": "node --test tests/release.artifact.mjs",
    "test:mutations": "node scripts/check-mutations.mjs",
    "measure:migration": "node scripts/measure-migration.mjs",
    "deploy": "npm run check && RELEASE_BUILD=1 npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "22.19.19",
    "prettier": "3.9.7",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.3",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "svelte": "5.56.8"
  }
}
